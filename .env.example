# ==============================================
# FUTSALBET — Variables de Entorno
# ==============================================
# Copiar este archivo como .env y completar los valores

# ------ BASE DE DATOS ------
# Formato para PostgreSQL: postgresql://USER:PASSWORD@HOST:PUERTO/NOMBRE_DB
DATABASE_URL="postgresql://DBUSER:DBPASS@localhost:5432/futsalbet"

# ------ JWT ------
JWT_SECRET="change_this_in_production_super_secret_key_2024"
JWT_EXPIRES_IN="7d"

# ------ SERVIDOR ------
PORT=3000
NODE_ENV="development"

# ------ FRONTEND ------
FRONTEND_URL="http://localhost:5173"

# ------ PUNTOS INICIALES ------
INITIAL_POINTS=1000

# ------ IMPORTADOR ------
# URL de la fuente de datos deportivos (si se obtiene autorización)
IMPORTER_SOURCE_URL=""
IMPORTER_SOURCE_API_KEY=""

# ------ EMAIL (para recuperación de contraseña - a implementar) ------
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
